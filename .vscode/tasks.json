  "version": "2.0.0",
  "tasks": [
      {
      "label": "warn-tsc",
      "type": "shell",
      "command": "npm run watch_tsc",
    },  
    {
      "label": "warn-eslint",
      "type": "shell",
      "command": "npm run run_eslint",
    },   
    {
      "label": "warn-oxlint",
      "type": "shell",
      "command": "npm run run_oxlint",
    },       
    {
      "label": "warn-biome",
      "type": "shell",
      "command": "npm run run_biome",
    },            
    {
      "label":"server",
      "type":"shell",
      "command":"npm run watch_server",
    },    
    {
      "label":"build",
      "type":"shell",
      "command":"npm run   watch_build",
    },

  
    {
      "label": "runall",
      "dependsOn": [
        "build",
      "warn-tsc",
        "warn-eslint",
        "warn-biome",
        "warn-oxlint",

        "server"
      ]
    }    
  ]
}