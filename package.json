    "esbuild-plugin-external-global": "^1.0.1",
    "eslint": "^9.36.0",
    "eslint-formatter-visualstudio": "^8.40.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.1",
    "oxlint": "^1.18.0",
    "oxlint-tsgolint": "0.2.0",
