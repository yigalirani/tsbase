{
 "$id": "https://spradeep.com/contact-us.schema.json",
 "title": "Contact us",
 "description": "Contact us",
 "type": "object",
 "properties": {
   "firstName": {
     "description": "First name of the user",
     "type": "string",
     "minLength": 3
   },
   "lastName": {
     "description": "Last name of the user",
     "type": "string",
    "minLength": 3
   },
   "email": {
     "description": "Email address of the user",
     "type": "string",
     "pattern": "^\\S+@\\S+\\.\\S+$",
     "minLength": 6,
     "maxLength": 127
   }
 },
 "required": [
   "firstName",
   "email",
   "lastName"
 ]
}